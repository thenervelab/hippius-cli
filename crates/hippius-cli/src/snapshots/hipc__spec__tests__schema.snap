          "help": "Follow every page: one JSON array, or one table in text mode; GET only"
        },
        {
          "name": "--reveal",
          "value_name": null,
          "required": false,
          "repeats": false,
          "possible_values": [],
          "default": null,
          "help": "Print a secret; required for the requests that return one, or nothing is sent"
