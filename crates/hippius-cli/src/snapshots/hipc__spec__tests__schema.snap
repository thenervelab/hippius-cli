    {
      "path": [
        "api"
      ],
      "effect": "non_idempotent",
      "confirmation": true,
      "reveal": true,
      "pagination": true,
      "confirmation_when": "the method is not `GET` or `HEAD`, or the request is a `GET` or `HEAD` of `/api/network/me/`, whose read may create something, with or without the trailing slash or a format suffix, and under any API version; a write to a route no command lists in its `routes` also warns that `hipc` does not know it",
      "reveal_when": "the route answers with a secret, or the request is a `GET` of a route no command lists in its `routes`, whose answer may hold one",
      "refused_when": "the target is a full URL off the configured API origin, or the request is a write other than `DELETE` of `/api/account/deletion/`, a write of `/api/cdn/zones/{zone_id}/hostnames/{hostname}/dns-setup/`, a write of `/api/registry/subscribe/`, `GET` or `HEAD` of `/api/kubernetes/clusters/{cluster_id}/secrets/`, any method of `/api/auth/token/`, a write of `/api/compute/app-engine/apps/`, of `/api/compute/app-engine/validate/`, or of `/api/compute/app-engine/apps/{vm_id}/compose/` whose body sets `secrets` (a body that is not a JSON object counts as setting it), or a write under `/api/support/` whose body holds `HIPPIUS_TOKEN` or a token a profile of the config file stores, as it is, quoted, percent-encoded, or behind a JSON escape, also when whitespace or an invisible joining character splits it, or an access key: 12 to 24 words of the BIP-39 list in a row whose checksum holds, with anything that is not a letter read as a space; a write is `POST`, `PUT`, `PATCH`, or `DELETE`, and each path counts in any letter case, with or without the trailing slash or a format suffix, and under any API version",
      "guards": [
        {
          "code": "change_isolation_required",
          "flag": "--change-isolation",
          "when": "the request is a `POST` of `/api/network/isolation/`; each rule holds for every write method of its route that has no rule of its own"
        },
        {
          "code": "public_required",
          "flag": "--public",
          "when": "the request is a `POST` of `/api/cdn/zones/`, a `PATCH` or `DELETE` of `/api/cdn/zones/{zone_id}/` whose body sets `origin`, a `PATCH` of `/api/registry/me/publicity/` unless its body sets `public` to `false`, or a `PUT` of `/api/objectstore/buckets/{bucket_name}/acl/set/`; a body that is not a JSON object counts as setting the key; each rule holds for every write method of its route that has no rule of its own; a `PUT` that borrows a rule on a key of the body needs the flag whatever its body sets"
        },
        {
          "code": "remove_others_required",
          "flag": "--remove-others",
          "when": "the request is a `PATCH` or `DELETE` of `/api/accounts/members/{member_id}/` whose body sets `grants`, a `PUT` of `/api/cdn/zones/{zone_id}/rules/`, a `PUT` of `/api/cdn/zones/{zone_id}/waf/rules/`, a `PUT` of `/api/cdn/zones/{zone_id}/waf/rate-limits/`, a `PATCH` or `DELETE` of `/api/cdn/lists/{list_name}/` whose body sets `items`, a `PUT` of `/api/cdn/lists/{list_name}/items/`, a `PUT` of `/api/compute/vms/{vm_id}/firewall/`, a `PUT` of `/api/v1/operator/nodes/{node_id}/storage/`, or a `PUT` of `/api/objectstore/buckets/{bucket_name}/acl/set/`; a body that is not a JSON object counts as setting the key; each rule holds for every write method of its route that has no rule of its own; a `PUT` that borrows a rule on a key of the body needs the flag whatever its body sets; a `POST` or `DELETE` of `/api/cdn/lists/{list_name}/items/`, which the API documents as doing something else, needs none"
        }
      ],
      "args": [
        {
          "name": "method",
          "value_name": "METHOD",
          "required": true,
          "repeats": false,
          "possible_values": [],
