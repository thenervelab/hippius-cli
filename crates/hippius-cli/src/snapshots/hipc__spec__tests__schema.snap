        {
          "name": "--public",
          "value_name": null,
          "required": false,
          "repeats": false,
          "possible_values": [],
          "default": null,
          "help": "Let a write publish a bucket that may be private, or open the Hub namespace; required for a POST of /cdn/zones/, a PATCH or DELETE of /cdn/zones/<zone_id>/ whose body sets origin, a PATCH of /registry/me/publicity/ unless its body sets public to false, and a PUT of /objectstore/buckets/<bucket_name>/acl/set/"
        },
        {
          "name": "--remove-others",
          "value_name": null,
          "required": false,
          "repeats": false,
          "possible_values": [],
          "default": null,
          "help": "Let a write that replaces a whole list or document remove the entries it leaves out; required for a PATCH or DELETE of /accounts/members/<member_id>/ whose body sets grants, a PUT of /cdn/zones/<zone_id>/rules/, a PUT of /cdn/zones/<zone_id>/waf/rules/, a PUT of /cdn/zones/<zone_id>/waf/rate-limits/, a PATCH or DELETE of /cdn/lists/<list_name>/ whose body sets items, a PUT of /cdn/lists/<list_name>/items/, a PUT of /compute/vms/<vm_id>/firewall/, a PUT of /objectstore/buckets/<bucket_name>/acl/set/, and an operator route hipc guards the same way"
        }
