        },
        {
          "name": "--public-ip",
          "value_name": null,
          "required": false,
          "repeats": false,
          "possible_values": [],
          "default": null,
          "help": "Attach a public IPv4 once the VM runs, billed until it is detached or the VM is deleted"
        },
        {
          "name": "--open-port",
          "value_name": "PORT",
          "required": false,
          "repeats": true,
          "possible_values": [],
          "default": null,
          "help": "Open this TCP port, 1 to 65535, to every IPv4 address once the launch is accepted; repeat it for more"
        },
        {
          "name": "--open-ssh",
          "value_name": null,
          "required": false,
          "repeats": false,
          "possible_values": [],
          "default": null,
          "help": "Same as --open-port 22, for SSH"
        },
        {
          "name": "--dedicated-disk",
          "value_name": "SIZE:TIER",
          "required": false,
          "repeats": true,
          "possible_values": [],
          "default": null,
          "help": "A whole physical disk for the VM, SIZE:TIER, such as 2000:hdd; repeat it once per disk, up to 8"
        },
        {
          "name": "--placement-group",
          "value_name": "NAME",
          "required": false,
          "repeats": false,
          "possible_values": [],
          "default": null,
          "help": "The anti-affinity group: two VMs of the account in one group never share a server"
        },
        {
          "name": "--os-disk-tier",
          "value_name": "TIER",
          "required": false,
          "repeats": false,
          "possible_values": [
            "nvme",
            "ssd",
            "hdd"
          ],
          "default": null,
          "help": "The OS disk's tier, a minimum: the disk may land on a faster one; the server defaults it to nvme"
        },
        {
          "name": "--backup-interval",
          "value_name": "SECONDS",
          "required": false,
          "repeats": false,
          "possible_values": [],
          "default": null,
          "help": "Turn on scheduled backups once the VM runs, at this many seconds between backups: 900, 3600, 21600, or 86400"
        },
        {
          "name": "--failover",
          "value_name": "MODE",
          "required": false,
          "repeats": false,
          "possible_values": [
            "auto",
            "manual"
          ],
          "default": null,
          "help": "The failover of those backups: auto restarts the VM on another server from its latest backup if its server dies, losing what was written after it; manual, the server's default, leaves that to Hippius support"
        },
